{
  "name": "sleeper-mcp",
  "version": "1.0.0",
  "description": "MCP server for the Sleeper fantasy football API — league data, rosters, drafts, stats, projections, and keeper analysis",
  "type": "module",
  "bin": {
    "sleeper-mcp": "dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
